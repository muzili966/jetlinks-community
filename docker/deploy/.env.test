# JetLinks test 环境变量
# 部署服务器放置于 /opt/jetlinks/compose/.env.test
# 注意：本文件含口令，勿提交真实生产值到仓库

# 镜像仓库（与 wxxpay 复用同一 Harbor，项目名区分）
REGISTRY=10.242.98.181:9093/jetlinks
TAG=latest

# 平台对外访问地址（前端跳转、设备回调用；换机器/换端口必须同步修改）
EXTERNAL_HOST=10.242.98.181

# admin 初始密码（仅首次启动创建用户时生效）
ADMIN_USER_PASSWORD=JetLinks.C0mmVn1ty

# PostgreSQL —— 宿主机源码编译实例，需已装 timescaledb 扩展
# 容器访问宿主机用 host.docker.internal（compose 已配 host-gateway），
# 也可直接填宿主机内网 IP；切勿填 127.0.0.1
PG_HOST=host.docker.internal
PG_PORT=5432
PG_DATABASE=jetlinks_test
PG_USERNAME=postgres
PG_PASSWORD=changeme
PG_SCHEMA=public

# Redis —— 宿主机已有实例
# 注意 database 要与 wxxpay 等其他系统错开，避免 key 互相污染
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DATABASE=4
REDIS_PASSWORD=

# 多租户开关：true 启用租户隔离/订阅计费；false 行为等同单租户版（回滚开关）
TENANT_ENABLED=true
